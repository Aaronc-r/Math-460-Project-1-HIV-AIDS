Cell[CellGroupData[{

Cell["Numerical Validation & Long Term Trajectory plots", "Section",
 CellChangeTimes->{{4.000073733657797*^9, 4.000073734590351*^9}, {
  4.000073910181116*^9, 
  4.000073914098648*^9}},ExpressionUUID->"61c16bf4-b9f8-e64f-abc5-\
25e70ab38c5f"],

Cell["\<\
The plotting horizons emphasize the transient behavior of each scenario. The \
integrations themselves extend to the longer horizons used in the \
numerical-check table.\
\>", "Text",ExpressionUUID->"c21b84e6-c25a-5740-a30e-7a944d720ed7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "solveScenario", ",", "solutions", ",", "terminalStates", ",", 
     "maxConservationErrors", ",", "numericalCheckTable", ",", 
     "trajectoryPlots"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"scenarioNames", "=", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Base\>\"", ",", "\"\<Treatment 1\>\"", ",", "\"\<Treatment 2\>\"", 
      ",", "\"\<Treatment 3\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Protect", " ", "against", " ", "machine"}], "-", 
    RowBox[{
    "precision", " ", "parameters", " ", "from", " ", "the", " ", "original", 
     " ", "notebook"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exactRhs", "=", 
   RowBox[{"Rationalize", "[", 
    RowBox[{"rhs", ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "12"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exactInitialState", "=", 
    RowBox[{"Rationalize", "[", 
     RowBox[{"initialState", ",", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Solve", " ", "one", " ", "named", " ", "scenario"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"solveScenario", "=", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"name", ",", "tmax"}], "}"}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ss", ",", "uu", ",", "pp", ",", "aa", ",", "rules", ",", 
          "equations"}], "}"}], ",", 
        RowBox[{
         RowBox[{"rules", "=", 
          RowBox[{"Rationalize", "[", 
           RowBox[{
            RowBox[{"parameterSets", "[", "name", "]"}], ",", 
            RowBox[{"10", "^", 
             RowBox[{"-", "12"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"equations", "=", 
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Derivative", "[", "1", "]"}], "[", "ss", "]"}], "[", 
               "t", "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Derivative", "[", "1", "]"}], "[", "uu", "]"}], "[", 
               "t", "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Derivative", "[", "1", "]"}], "[", "pp", "]"}], "[", 
               "t", "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Derivative", "[", "1", "]"}], "[", "aa", "]"}], "[", 
               "t", "]"}]}], "}"}], "==", 
            RowBox[{"ReplaceAll", "[", 
             RowBox[{
              RowBox[{"ReplaceAll", "[", 
               RowBox[{"exactRhs", ",", 
                RowBox[{"Thread", "[", 
                 RowBox[{"vars", "->", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"ss", "[", "t", "]"}], ",", 
                    RowBox[{"uu", "[", "t", "]"}], ",", 
                    RowBox[{"pp", "[", "t", "]"}], ",", 
                    RowBox[{"aa", "[", "t", "]"}]}], "}"}]}], "]"}]}], "]"}], 
              ",", "rules"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"equations", ",", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ss", "[", "0", "]"}], ",", 
                 RowBox[{"uu", "[", "0", "]"}], ",", 
                 RowBox[{"pp", "[", "0", "]"}], ",", 
                 RowBox[{"aa", "[", "0", "]"}]}], "}"}], "==", 
