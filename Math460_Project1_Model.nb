Cell[BoxData[
 RowBox[{
  RowBox[{"treat2", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"S", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{"\[Beta]", " ", "c", " ", 
          RowBox[{"S", "[", "t", "]"}], 
          RowBox[{"U", "[", "t", "]"}]}], "1000"]}], "-", 
       FractionBox[
        RowBox[{"\[Omega]", " ", "c", " ", 
         RowBox[{"S", "[", "t", "]"}], 
         RowBox[{"P", "[", "t", "]"}]}], "1000"], "-", 
       RowBox[{"\[Tau]", " ", 
        RowBox[{"S", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"U", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       FractionBox[
        RowBox[{"\[Beta]", " ", "c", " ", 
         RowBox[{"S", "[", "t", "]"}], 
         RowBox[{"U", "[", "t", "]"}]}], "1000"], "+", 
       FractionBox[
        RowBox[{"\[Omega]", " ", "c", " ", 
         RowBox[{"S", "[", "t", "]"}], 
         RowBox[{"P", "[", "t", "]"}]}], "1000"], "-", 
       RowBox[{"\[Alpha]", " ", 
        RowBox[{"U", "[", "t", "]"}]}], "+", 
       RowBox[{"\[Tau]", " ", 
        RowBox[{"S", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"P", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"\[Epsilon]", " ", "\[Alpha]", " ", 
        RowBox[{"U", "[", "t", "]"}]}], "-", 
       RowBox[{"\[Mu]", " ", 
        RowBox[{"P", "[", "t", "]"}]}]}]}], " ", ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"A", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Epsilon]"}], ")"}], "\[Alpha]", " ", 
        RowBox[{"U", "[", "t", "]"}]}], "+", 
       RowBox[{"\[Mu]", " ", 
        RowBox[{"P", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
