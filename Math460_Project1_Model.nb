Cell[CellGroupData[{

Cell["Find the equilibria", "Section",
 CellChangeTimes->{
  4.0000766846270924`*^9},ExpressionUUID->"3fa8fc55-b557-084e-be00-\
b3ef227e44a2"],

Cell["\<\
Equilibrium is a state where all of our derivatives are zero. Calculation \
requires the four dependent variables to be nonnegative and to sum to 1000.\
\>", "Text",
 CellChangeTimes->{{4.00017064587763*^9, 
  4.000170679058588*^9}},ExpressionUUID->"3cdb0348-9412-fe47-bc1a-\
cdda5aa6bc2c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "equilibriumConditions", ",", "equilibriumResults", ",", 
     "equilibriumDataset"}], "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "equilibrium", " ", "requirements"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"equilibriumConditions", "=", 
    RowBox[{
     RowBox[{"Apply", "[", 
      RowBox[{"And", ",", 
       RowBox[{"Thread", "[", 
        RowBox[{"rhs", "==", "0"}], "]"}]}], "]"}], "&&", 
     RowBox[{
      RowBox[{"s", "+", "u", "+", "p", "+", "a"}], "==", "1000"}], "&&", 
     RowBox[{"Apply", "[", 
      RowBox[{"And", ",", 
       RowBox[{"Thread", "[", 
        RowBox[{"vars", ">=", "0"}], "]"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "the", " ", "complete", " ", "feasible", " ", 
    "equilibrium", " ", "set", " ", "for", " ", "each", " ", "model"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"equilibriumResults", "=", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "name", "}"}], ",", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Reduce", "[", 
          RowBox[{
           RowBox[{"ReplaceAll", "[", 
            RowBox[{"equilibriumConditions", ",", 
             RowBox[{"parameterSets", "[", "name", "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "u", ",", "p", ",", "a"}], "}"}], ",", 
           "Reals"}], "]"}], "]"}]}], "]"}], ",", "scenarioNames"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Construct", " ", "and", " ", "validate", " ", "the", " ", "equilibrium", 
    " ", "Dataset"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"equilibriumDataset", "=", 
    RowBox[{"Dataset", "[", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "name", "}"}], ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "parameters", ",", "result", ",", "zeroDerivativeCondition", ",", 
             "populationCondition", ",", "nonnegativeCondition", ",", 
             "terminalPointCondition", ",", "derivativeCheck", ",", 
             "populationCheck", ",", "nonnegativeCheck", ",", 
             "isSingleTerminalPoint", ",", "equilibriumType"}], "}"}], ",", 
           RowBox[{
            RowBox[{"parameters", "=", 
             RowBox[{"parameterSets", "[", "name", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"result", "=", 
             RowBox[{"equilibriumResults", "[", "name", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Conditions", " ", "used", " ", "to", " ", "validate", " ", 
              "the", " ", "result"}], "*)"}], 
            RowBox[{"zeroDerivativeCondition", "=", 
             RowBox[{"Apply", "[", 
              RowBox[{"And", ",", 
               RowBox[{"Thread", "[", 
                RowBox[{
                 RowBox[{"ReplaceAll", "[", 
                  RowBox[{"rhs", ",", "parameters"}], "]"}], "==", "0"}], 
                "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"populationCondition", "=", 
             RowBox[{
              RowBox[{"s", "+", "u", "+", "p", "+", "a"}], "==", "1000"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"nonnegativeCondition", "=", 
             RowBox[{"Apply", "[", 
              RowBox[{"And", ",", 
               RowBox[{"Thread", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"s", ",", "u", ",", "p", ",", "a"}], "}"}], ">=", 
                 "0"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"terminalPointCondition", "=", 
             RowBox[{"Apply", "[", 
              RowBox[{"And", ",", 
               RowBox[{"Thread", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"s", ",", "u", ",", "p", ",", "a"}], "}"}], "==", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "0", ",", "0", ",", "1000"}], "}"}]}], 
                "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Verify", " ", "that", " ", "every", " ", "equilibrium", " ", 
              "makes", " ", "all", " ", "four", " ", "derivatives", " ", 
              "equal", " ", "zero"}], "*)"}], 
            RowBox[{"derivativeCheck", "=", 
             RowBox[{"TrueQ", "[", 
              RowBox[{"Resolve", "[", 
               RowBox[{
                RowBox[{"ForAll", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"s", ",", "u", ",", "p", ",", "a"}], "}"}], ",", 
                  RowBox[{"Implies", "[", 
                   RowBox[{"result", ",", "zeroDerivativeCondition"}], 
                   "]"}]}], "]"}], ",", "Reals"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Verify", " ", "that", " ", "every", " ", "equilibrium", " ", 
              "has", " ", "total", " ", "population", " ", "1000"}], "*)"}], 
            RowBox[{"populationCheck", "=", 
             RowBox[{"TrueQ", "[", 
              RowBox[{"Resolve", "[", 
               RowBox[{
                RowBox[{"ForAll", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"s", ",", "u", ",", "p", ",", "a"}], "}"}], ",", 
                  RowBox[{"Implies", "[", 
                   RowBox[{"result", ",", "populationCondition"}], "]"}]}], 
                 "]"}], ",", "Reals"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Verify", " ", "that", " ", "every", " ", "equilibrium", " ", 
              "is", " ", "nonnegative"}], "*)"}], 
            RowBox[{"nonnegativeCheck", "=", 
             RowBox[{"TrueQ", "[", 
              RowBox[{"Resolve", "[", 
               RowBox[{
                RowBox[{"ForAll", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"s", ",", "u", ",", "p", ",", "a"}], "}"}], ",", 
                  RowBox[{"Implies", "[", 
                   RowBox[{"result", ",", "nonnegativeCondition"}], "]"}]}], 
                 "]"}], ",", "Reals"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Determine", " ", "whether", " ", "the", " ", "equilibrium", " ",
               "set", " ", "is", " ", "exactly", " ", "the", " ", "single", 
              " ", "point", " ", 
              RowBox[{"(", 
               RowBox[{"0", ",", "0", ",", "0", ",", "1000"}], ")"}]}], 
             "*)"}], 
            RowBox[{"isSingleTerminalPoint", "=", 
             RowBox[{"TrueQ", "[", 
              RowBox[{"Resolve", "[", 
               RowBox[{
                RowBox[{"ForAll", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"s", ",", "u", ",", "p", ",", "a"}], "}"}], ",", 
                  RowBox[{"Equivalent", "[", 
                   RowBox[{"result", ",", "terminalPointCondition"}], "]"}]}],
                  "]"}], ",", "Reals"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"equilibriumType", "=", 
             RowBox[{"If", "[", 
              RowBox[{
              "isSingleTerminalPoint", ",", "\"\<Single equilibrium\>\"", 
               ",", "\"\<Family of equilibria\>\""}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Association", "[", 
